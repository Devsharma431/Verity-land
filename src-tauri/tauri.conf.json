{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Verity",
  "version": "1.2.0",
  "identifier": "com.verityai.desktop",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Verity-AI",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFDRTg1RjNGREUwNzAzM0UKUldRK0F3ZmVQMS9vSEp5cXRpYnFGUnN3bWUyZzlMbFgraDllL3R2bkQ1UHd5MyttL0F1STgvMGoK",
      "endpoints": [
        "https://verity-ai-kappa.vercel.app/updates/version.json"
      ]
    }
  }
}
